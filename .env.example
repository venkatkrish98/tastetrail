# TasteTrail Environment Configuration
# Copy this file to .env.local for local development.

# Official Qloo Hackathon API Key
# Sign up and obtain your key from the Qloo Hackathon portal.
# In live mode, requests will be routed to https://hackathon.api.qloo.com
# If left empty, TasteTrail automatically operates in transparent "Sample Data Demo Mode"
# with labeled fixture datasets so judges can test immediately without credentials.
QLOO_API_KEY=your_hackathon_api_key_here

# Base URL for Qloo Hackathon endpoint (defaults to https://hackathon.api.qloo.com)
QLOO_BASE_URL=https://hackathon.api.qloo.com
